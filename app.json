{
  "name": "Era-Vibes",
  "description": "A Telegram Music Player Bot, written in Python with Pyrogram and Py-Tgcalls.",
  "logo": "https://te.legra.ph/file/b8a0c1a00db3e57522b53.jpg",
  "keywords": [
    "python3",
    "telegram",
    "bot",
    "MusicBot",
    "telegram-bot",
    "pyrogram"
  ],
  "env": {
    "API_ID": {
      "description": "Get this value from https://my.telegram.org",
      "value": "24168862",
      "required": true
    },
    "API_HASH": {
      "description": "Get this value from https://my.telegram.org",
      "value": "916a9424dd1e58ab7955001ccc0172b3",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "A Bot's token from Botfather",
      "value": "",
      "required": true
    },
    "MONGO_URL": {
      "description": "Get a mongodb url from https://cloud.mongodb.com.",
      "value": "mongodb+srv://Hello:Hello@cluster0.pi9ks.mongodb.net/?retryWrites=true&w=majority",
      "required": true
    },
    "OWNER_ID": {
      "description": "The user id of user whom you would like to add as OWNER.",
      "value": "1679112664",
      "required": true
    },
    "STRING_SESSION": {
      "description": "A Pyrogram v2 String Session.",
      "value": "",
      "required": true
    },
    "LOG_GROUP_ID": {
      "description": "Your Log Group ID, add your bot and promote as an admin with full rights!. Channel ki id mat daal dena bsdk.",
      "value": "-1002418545472",
      "required": true
    },
    "START_IMAGE_URL": {
      "description": "Bot Start image link",
      "value": "https://files.catbox.moe/t5gy4y.jpg",
      "required": true
    },
    "UPSTREAM_REPO": {
      "description": "If you dont know this, Leave as it is",
      "value": "https://github.com/IamElite/MBV3",
      "required": true
    },
    "UPSTREAM_BRANCH": {
      "description": "Upstream Repo's Branch Name",
      "value": "m4",
      "required": true
    }
  },
  "buildpacks": [
    {
      "url": "heroku/python"
    },
    {
      "url": "heroku/nodejs"
    },
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git"
    }
  ],
  "stack": "container",
  "formation": {
    "worker": {
      "quantity": "1",
      "size": "Standard-2X"
    }
  }
}
